# ──────────────────────────────────────────────────────────────────────────
# Makhana CRM — environment variables
# Copy this file to .env.local for local dev. On Vercel, set the same keys
# under Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────────────────
# Get this from neon.tech → your project → Connection string.
# Use the pooled connection string for the app; un-pooled is fine for migrations.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client for SIGNING IN to the CRM.
# Create at console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (and your Vercel URL once deployed).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: required when deployed behind a proxy (Vercel sets this automatically)
# AUTH_TRUST_HOST=true

# ─── Gmail OAuth (separate from sign-in OAuth) ───────────────────────────
# This is the OAuth client used to read+send from the shared inbox (doks23@gmail.com).
# You can reuse AUTH_GOOGLE_ID/SECRET if you add Gmail scopes to that same client,
# but a separate client is cleaner. Add scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/gmail.compose
# Redirect URI: <APP_URL>/api/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# ─── Encryption key for Gmail refresh tokens at rest ─────────────────────
# Generate with: openssl rand -hex 32  (must be 64 hex chars = 32 bytes)
ENCRYPTION_KEY=

# ─── LLM providers (pick at least one) ───────────────────────────────────
# The active classifier/drafter provider is set in business_profile (editable
# in Settings). The CRM only calls a provider when its key is present.

# Google Gemini — recommended default for classification (cheap, multilingual).
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — recommended default for drafting (strong tone control).
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama — self-hosted local LLM server. No API key, only a base URL.
# Default if unset: http://localhost:11434
# Run `ollama pull llama3.1:8b` (or similar) before enabling.
OLLAMA_BASE_URL=http://localhost:11434

# ─── Inngest ─────────────────────────────────────────────────────────────
# Get from app.inngest.com → Project → Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Seed script ─────────────────────────────────────────────────────────
# The Google email that becomes the first Owner. Used only by `npm run db:seed`.
SEED_OWNER_EMAIL=doks23@gmail.com

# ─── App URL (used by Auth.js redirects in some scenarios) ───────────────
# Local: http://localhost:3000
# Vercel sets VERCEL_URL automatically.
NEXTAUTH_URL=http://localhost:3000
